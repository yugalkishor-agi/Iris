rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Avatars - users can upload/update their own, anyone can read
    match /avatars/{userId}/{filename} {
      allow read: if true; // Public read
      allow write: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
    
    // Posts - users can upload their own, anyone can read
    match /posts/{userId}/{postId}/{filename} {
      allow read: if true; // Public read
      allow write: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
    
    // Stories - users can upload their own, anyone can read
    match /stories/{userId}/{filename} {
      allow read: if true; // Public read
      allow write: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
    
    // Messages - only users in conversation can access
    match /messages/{userId}/{conversationId}/{filename} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
