rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isParticipant(participantIds) {
      return request.auth.uid in participantIds;
    }

    function hasPostCollabRequest(postId, userId) {
      return exists(/databases/$(database)/documents/posts/$(postId)/collaborationRequests/$(userId));
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Allow read for signed-in users AND unauthenticated users (for username checks during signup)
      allow read: if true;
      
      // Only auth can create their own user doc during signup
      allow create: if isSignedIn() && isOwner(userId);
      
      // Update rules - owner OR limited fields for follows/stats
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        // Allow stat updates (follows, posts count)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'updatedAt', 'lastActiveAt']) &&
         request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly(['followersCount', 'followingCount', 'postsCount'])) ||
        // Allow online status updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'lastSeen', 'updatedAt'])
      );
      
      allow delete: if isSignedIn() && isOwner(userId);
      
      // Subcollections
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
      
      match /following/{followingId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
      
      match /blockedUsers/{blockedUserId} {
  allow get: if isSignedIn() && (
    isOwner(userId) ||
    blockedUserId == request.auth.uid
  );

  allow list: if isSignedIn() && isOwner(userId);

  allow create, update, delete: if isSignedIn() && isOwner(userId);
}
      
      match /saved/{postId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      // Saved collections under user
      match /savedCollections/{collectionId} {
        allow read, write: if isSignedIn() && isOwner(userId);

        // Saved posts within a collection
        match /posts/{postId} {
          allow read, write: if isSignedIn() && isOwner(userId);
        }
      }
      
      match /messageRequests/{requestId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && isOwner(userId);
      }

      match /privacySettings/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isOwner(userId);
      }

      match /notificationPreferences/{docId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      match /mutedUsers/{mutedUserId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      match /closeFriends/{friendId} {
        allow get: if isSignedIn() && (
          isOwner(userId) ||
          friendId == request.auth.uid
        );
        allow list: if isSignedIn() && isOwner(userId);
        allow create, update, delete: if isSignedIn() && isOwner(userId);
      }

      // Fast liked-state hydration index for posts + glimpses
      match /likedContent/{contentKey} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      match /followRequests/{requesterId} {
        allow read: if isSignedIn() && (isOwner(userId) || request.auth.uid == requesterId);
        allow create: if isSignedIn();
        allow delete: if isSignedIn() && (isOwner(userId) || request.auth.uid == requesterId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      match /pushTokens/{tokenId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      match /secureDevices/{deviceId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isOwner(userId);
      }

      match /dataExports/{exportId} {
        allow read, create, update, delete: if isSignedIn() && isOwner(userId);
      }
      
      match /contentFilters/{filterId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      
      match /searchHistory/{searchId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }
    
    // ==========================================
    // POSTS COLLECTION
    // ==========================================
    match /posts/{postId} {
      // Anyone signed in can read posts
      allow read: if isSignedIn();
      
      // Anyone signed in can create posts
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      
      // Owner can update OR anyone can update stats/engagement OR invited collaborator can accept/decline themselves
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.userId == request.auth.uid || // legacy posts compatibility
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'engagement', 'lastEngagementAt', 'updatedAt']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators', 'updatedAt']) &&
          hasPostCollabRequest(postId, request.auth.uid)
        )
      );
      
      // Only owner can delete
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Post collaboration requests (doc id = collaborator userId)
      match /collaborationRequests/{requestId} {
        allow read: if isSignedIn() && (
          request.auth.uid == requestId ||
          request.auth.uid == resource.data.fromUserId ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
        );

        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.fromUserId &&
          requestId == request.resource.data.toUserId &&
          request.resource.data.postId == postId;

        allow update: if isSignedIn() && (
          request.auth.uid == requestId ||
          request.auth.uid == resource.data.fromUserId ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
        );

        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.fromUserId ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
        );
      }
      
      // Post likes subcollection
      match /likes/{likeId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && likeId == request.auth.uid;
        allow delete: if isSignedIn() && likeId == request.auth.uid;
      }
      
      // Post saves subcollection
      match /saves/{saveId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && saveId == request.auth.uid;
        allow update: if isSignedIn() && saveId == request.auth.uid;
        allow delete: if isSignedIn() && saveId == request.auth.uid;
      }
      
      // Post comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        // Comment author can update OR post owner can update (for pinning) OR anyone can update likes/stats
        allow update: if isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedByCreator', 'updatedAt'])
        );
        // Allow delete by comment author OR post owner (moderation)
        allow delete: if isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        );
        
        // Comment likes
        match /likes/{likeId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && likeId == request.auth.uid;
          allow delete: if isSignedIn() && likeId == request.auth.uid;
        }
      }
    }
    
    // ==========================================
    // STORIES COLLECTION (SECURE)
    // ==========================================
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']) &&
          request.resource.data.stats is map &&
          resource.data.stats is map &&
          request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly(['viewsCount', 'likesCount', 'repliesCount'])
        )
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{likeId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && likeId == request.auth.uid;
      }

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.senderId == request.auth.uid
        );
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == resource.data.senderId ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
        );
        allow update: if false;
      }

      match /views/{viewId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && viewId == request.auth.uid;
      }

      match /pollVotes/{voteId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.resource.data.voterId == request.auth.uid
          && voteId == (request.resource.data.stickerId + '_' + request.resource.data.voterId)
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0;
        allow delete: if false;
      }

      match /sliderValues/{id} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && id == (request.resource.data.stickerId + '_' + request.resource.data.userId)
          && request.resource.data.value is number
          && request.resource.data.value >= 0 && request.resource.data.value <= 1;
        allow delete: if false;
      }

      match /questionReplies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.senderId ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
        );
        allow update: if false;
      }

      match /quizAnswers/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && id == (request.resource.data.stickerId + '_' + request.resource.data.userId)
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0;
        allow update, delete: if false;
      }

      // Widgets subcollection (for interactive stickers)
      match /widgets/{widgetId} {
        allow read: if isSignedIn();
        // Only story owner can create/update widgets
        allow create, update: if isSignedIn() && 
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && 
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        
        // Widget responses subcollection
        match /responses/{responseId} {
          allow read: if isSignedIn();
          allow create, update: if isSignedIn() && responseId == request.auth.uid;
          allow delete: if false;
        }
      }
    }
    
    // ==========================================
    // HIGHLIGHTS COLLECTION
    // ==========================================
    match /highlights/{highlightId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Highlight stories subcollection
      match /stories/{storyId} {
        allow read: if isSignedIn();
        // SECURE: Validate userId stored in the subcollection document itself
        // No need for get() - avoids batch commit issues
        allow create, update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      }
    }
    
    // ==========================================
    // GLIMPSES COLLECTION (Reels/Short Videos)
    // ==========================================
    match /glimpses/{glimpseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      
      // Owner can update OR anyone can update views/stats OR system can update collaborators
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'likesCount', 'repliesCount', 'stats', 'updatedAt']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators', 'updatedAt'])
      );
      
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      
      // Glimpse likes subcollection
      match /likes/{likeId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && likeId == request.auth.uid;
        allow delete: if isSignedIn() && likeId == request.auth.uid;
      }
      
      // Glimpse views subcollection
      match /views/{viewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && viewId == request.auth.uid;
        allow update: if isSignedIn() && viewId == request.auth.uid;
      }
      
      // Glimpse comments/replies
      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
      
      // Glimpse comments subcollection (same as posts)
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        // Comment author can update OR glimpse owner can update (for pinning) OR anyone can update likes/stats
        allow update: if isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/glimpses/$(glimpseId)).data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedByCreator', 'updatedAt'])
        );
        // Allow delete by comment author OR glimpse owner (moderation)
        allow delete: if isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/glimpses/$(glimpseId)).data.authorId == request.auth.uid
        );
        
        // Comment likes for glimpses
        match /likes/{likeId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && likeId == request.auth.uid;
          allow delete: if isSignedIn() && likeId == request.auth.uid;
        }
      }
    }
    
    // ==========================================
    // CONVERSATIONS & MESSAGES
    // Note: Simplified rules to avoid circular dependencies
    // Conversation creation validates participants
    // Message creation only validates sender
    // ==========================================
    match /conversations/{conversationId} {
      // TEMPORARY: Very permissive rules for debugging
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
      
      // Messages subcollection
      match /messages/{messageId} {
        // TEMPORARY: Very permissive for debugging
        allow read, create, update: if isSignedIn();
        
        // ORIGINAL UPDATE LOGIC (commented for now)
        /* allow update: if isSignedIn() && (
            // Non-sender updates read status
            (request.auth.uid != resource.data.senderId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'status', 'readAt', 'updatedAt'])) ||
            // Sender soft deletes
            (request.auth.uid == resource.data.senderId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'text', 'deletedBy', 'deletedAt', 'updatedAt']))
          ); */
      }
      
      // Typing indicators
      match /typing/{userId} {
        allow read: if isSignedIn() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
        
        allow write: if isSignedIn() &&
          request.auth.uid == userId &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
      }
    }
    
    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    match /notifications/{notificationId} {
      // Allow any signed-in user to read notifications
      // (needed for aggregated story likes where likers query owner's notifications)
      allow read: if isSignedIn();
      
      // Anyone can create notifications (for sending to others)
      allow create: if isSignedIn();
      
      // Anyone can update notifications (needed for aggregated story likes)
      // where multiple users add themselves to the likersData array
      allow update: if isSignedIn();
      
      // Only recipient can delete
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // ==========================================
    // SAVED COLLECTIONS
    // ==========================================
    match /savedCollections/{collectionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // ==========================================
    // HASHTAGS
    // ==========================================
    match /hashtags/{hashtagId} {
      // Anyone can read hashtags
      allow read: if isSignedIn();
      
      // Anyone can write hashtags (for creating/updating counts)
      allow write: if isSignedIn();
    }
    
    // ==========================================
    // DIRECT MESSAGES (DM) SYSTEM
    // ==========================================
    match /directMessages/{conversationId} {
      allow read, write: if isSignedIn() && 
        request.auth.uid in resource.data.participants;
    }
    
    match /dmMessages/{messageId} {
      allow read: if isSignedIn() && 
        (request.auth.uid == resource.data.senderId ||
         request.auth.uid == resource.data.recipientId);
      
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.senderId;
      
      allow update: if isSignedIn() && 
        (request.auth.uid == resource.data.senderId ||
         request.auth.uid == resource.data.recipientId);
    }
    
    match /messageRequests/{requestId} {
      allow read: if isSignedIn() && 
        (request.auth.uid == resource.data.requesterId ||
         request.auth.uid == resource.data.recipientId);
      
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.requesterId;
      
      allow update: if isSignedIn() && 
        request.auth.uid == resource.data.recipientId;
    }
    
    // ==========================================
    // GROUP CHATS SYSTEM
    // ==========================================
    match /groupChats/{chatId} {
      allow read, write: if isSignedIn() && 
        request.auth.uid in resource.data.participants;
    }
    
    match /groupMessages/{messageId} {
      allow read: if isSignedIn() && 
        isGroupParticipant(request.auth.uid, resource.data.chatId);
      
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.senderId &&
        isGroupParticipant(request.auth.uid, request.resource.data.chatId);
    }
    
    // ==========================================
    // REELS SYSTEM
    // ==========================================
    match /reels/{reelId} {
      allow read: if isSignedIn() && 
        (resource.data.visibility == 'public' ||
         resource.data.authorId == request.auth.uid ||
         (resource.data.visibility == 'followers' && 
          isFollowing(request.auth.uid, resource.data.authorId)));
      
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.authorId;
      
      allow update: if isSignedIn() && 
        request.auth.uid == resource.data.authorId;
    }
    
    match /reelViews/{viewId} {
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.userId;
      
      allow read: if isSignedIn() && 
        request.auth.uid == resource.data.userId;
    }
    
    match /reelComments/{commentId} {
      allow read: if isSignedIn() && 
        canViewReel(request.auth.uid, resource.data.reelId);
      
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.authorId &&
        canViewReel(request.auth.uid, request.resource.data.reelId);
    }
    
    // ==========================================
    // UNIVERSAL COMMENTS SYSTEM
    // ==========================================
    match /comments/{commentId} {
      allow read: if isSignedIn() && 
        canReadTarget(request.auth.uid, resource.data.targetType, resource.data.targetId);
      
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.authorId &&
        canReadTarget(request.auth.uid, request.resource.data.targetType, request.resource.data.targetId);
      
      allow update: if isSignedIn() && 
        request.auth.uid == resource.data.authorId;
      
      allow delete: if isSignedIn() && 
        request.auth.uid == resource.data.authorId;
    }
    
    // ==========================================
    // UNIVERSAL LIKES SYSTEM
    // ==========================================
    match /likes/{likeId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.userId;
      
      allow delete: if isSignedIn() && 
        request.auth.uid == resource.data.userId;
    }
    
    // ==========================================
    // PHONE VERIFICATIONS (AUTH)
    // ==========================================
    match /phoneVerifications/{requestId} {
      allow read, write: if isSignedIn();
    }
    
    // ==========================================
    // APP SETTINGS
    // ==========================================
    match /settings/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // ==========================================
    // HELPER FUNCTIONS FOR NEW COLLECTIONS
    // ==========================================
    function isGroupParticipant(userId, chatId) {
      return userId in get(/databases/$(database)/documents/groupChats/$(chatId)).data.participants;
    }
    
    function canViewReel(userId, reelId) {
      let reel = get(/databases/$(database)/documents/reels/$(reelId));
      return reel.data.visibility == 'public' ||
             reel.data.authorId == userId ||
             (reel.data.visibility == 'followers' && 
              isFollowing(userId, reel.data.authorId));
    }
    
    function canReadTarget(userId, targetType, targetId) {
      return (
        (targetType == 'post' && canReadPost(userId, targetId)) ||
        (targetType == 'reel' && canViewReel(userId, targetId)) ||
        (targetType == 'glimpse' && isSignedIn())
      );
    }
    
    function canReadPost(userId, postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId));
      return post.data.isPublic == true ||
             post.data.authorId == userId ||
             isSignedIn();
    }
    
    function isFollowing(followerId, followingId) {
      return exists(/databases/$(database)/documents/users/$(followingId)/followers/$(followerId));
    }
  }
}









