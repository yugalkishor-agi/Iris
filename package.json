{
  "name": "iris-native",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "vite",
    "build:android": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "build:local": "npx expo run:android",
    "build:apk": "npx expo prebuild --platform android && cd android && gradlew assembleRelease",
    "prebuild": "npx expo prebuild --platform android",
    "test": "vitest --run",
    "format.fix": "prettier --write .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "dotenv": "^17.2.1",
    "expo": "~52.0.0",
    "expo-av": "~15.0.1",
    "expo-camera": "~16.0.9",
    "expo-file-system": "~18.0.4",
    "expo-image-picker": "~16.0.3",
    "expo-linear-gradient": "~14.0.1",
    "expo-media-library": "~17.0.3",
    "expo-status-bar": "~2.0.0",
    "firebase": "^12.4.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.3.0",
    "react-native-svg": "15.8.0",
    "react-native-vector-icons": "^10.2.0",
    "@react-navigation/native": "^7.0.13",
    "@react-navigation/native-stack": "^7.1.9",
    "@react-navigation/bottom-tabs": "^7.2.2",
    "nativewind": "^4.1.23",
    "zod": "^3.25.76",
    "zustand": "^4.5.5",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "react-native-paper": "^5.12.5",
    "@expo/vector-icons": "^14.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.11",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.9.2"
  }
}
